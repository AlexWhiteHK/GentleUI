{
	"schemaVersion": 1,
	"id": "gentleui",
	"version": "${version}",
	"name": "GentleUI",
	"description": "A modern, animated interface for Minecraft's menus. Three themes: Liquid (default), Material and Glass.",
	"authors": ["AlexWhite"],
	"contact": {
		"homepage": "https://github.com/AlexWhiteHK/GentleUI",
		"sources": "https://github.com/AlexWhiteHK/GentleUI",
		"issues": "https://github.com/AlexWhiteHK/GentleUI/issues"
	},
	"license": "MIT",
	"icon": "assets/gentleui/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.alexwhitehk.gentleui.fabric.GentleUIClient"],
		"modmenu": ["io.github.alexwhitehk.gentleui.fabric.compat.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "gentleui.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "gentleui.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"java": ">=21"
	},
	"suggests": {
		"modmenu": "*"
	}
}
